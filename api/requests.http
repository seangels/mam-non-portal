DELETE {{host}}/api/v1/students/{{studentId}}?expectedVersion={{studentVersion}}
Authorization: Bearer {{accessToken}}

###

GET {{host}}/api/v1/attendance/context?date={{attendanceDate}}
Authorization: Bearer {{accessToken}}

###

GET {{host}}/api/v1/attendance/daily?date={{attendanceDate}}&groupId={{groupId}}
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/attendance/sheets
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "groupId": "{{groupId}}",
  "date": "{{attendanceDate}}",
  "expectedSnapshotVersion": 1,
  "records": [
    {
      "studentId": "{{studentId}}",
      "status": "Unmarked",
      "halfDayPart": null,
      "isExcused": null,
      "durationMinutes": null,
      "notes": null
    }
  ]
}

###

PUT {{host}}/api/v1/attendance/sheets/{{sheetId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "expectedVersion": 1,
  "records": [
    {
      "studentId": "{{studentId}}",
      "status": "AbsentHalfDay",
      "halfDayPart": null,
      "isExcused": true,
      "durationMinutes": null,
      "notes": "Gia đình đã báo"
    }
  ]
}

###

GET {{host}}/api/v1/assessment-sheets?page=1&pageSize=20&studentId={{studentId}}&status=Open&sortBy=updatedAt&sortOrder=desc
Authorization: Bearer {{accessToken}}

###

GET {{host}}/api/v1/assessment-sheets/plan-candidates?studentId={{studentId}}&latestGradeAtOrBelow=B&groupLv1Name=&sortBy=rowIndex&sortOrder=asc
Authorization: Bearer {{accessToken}}

###

GET {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/assessment-sheets
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "studentId": "{{studentId}}",
  "responsibleTeacherId": null,
  "note": null,
  "startDate": "2026-08-20T00:00:00+07:00",
  "dueDate": "2026-10-31T00:00:00+07:00",
  "records": [
    {
      "assessmentId": "{{assessmentId}}",
      "latestGrade": "A",
      "note": "Ghi chú gần nhất"
    }
  ]
}

###

PUT {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "8.9.10.26",
  "responsibleTeacherId": "{{teacherId}}",
  "note": null,
  "startDate": "2026-08-20T00:00:00+07:00",
  "dueDate": "2026-10-31T00:00:00+07:00",
  "feedback": null
}

###

PUT {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/records
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "records": [
    {
      "assessmentId": "{{assessmentId}}",
      "planGrade": "B",
      "planNote": null,
      "finalGrade": null,
      "finalNote": null,
      "displayOrder": 1
    }
  ]
}

###
# Import Excel (multipart/form-data field `file`, .xlsx <= 10 MB):
#   POST {{host}}/api/v1/assessment-sheets/import-excel/preview   -> validate, không ghi DB
#   POST {{host}}/api/v1/assessment-sheets/import-excel           -> ghi DB
# Header bắt buộc: planGrade, planNote, assessmentCode, studentCode, studentName, startDate, dueDate
# Header tùy chọn: STT (-> displayOrder, số chạy toàn cục theo thứ tự dòng),
#                  groupLv2Name, groupLv3Name (fill-down kiểu ô merge -> assessmentSnapshot)

###

PUT {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "Done"
}

###
# Upload PDF kế hoạch do UI preview tạo bằng html2pdf.js.
# Endpoint này không gọi generate-plan-pdf cũ và yêu cầu Student.driveFolderId để lưu đúng thư mục Drive học viên.
# Đổi đường dẫn file PDF mẫu bên dưới trước khi chạy thật.
POST {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/upload-plan-pdf
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=PlanPdfBoundary

--PlanPdfBoundary
Content-Disposition: form-data; name="file"; filename="ke-hoach-ca-nhan-test.pdf"
Content-Type: application/pdf

< ./samples/ke-hoach-ca-nhan-test.pdf
--PlanPdfBoundary--

###

# Upload PDF kết quả do UI preview tạo bằng html2pdf.js.
# Endpoint này không gọi generate-result-pdf cũ và yêu cầu Student.driveFolderId để lưu đúng thư mục Drive học viên.
# Đổi đường dẫn file PDF mẫu bên dưới trước khi chạy thật.
POST {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/upload-result-pdf
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=ResultPdfBoundary

--ResultPdfBoundary
Content-Disposition: form-data; name="file"; filename="ket-qua-ca-nhan-test.pdf"
Content-Type: application/pdf

< ./samples/ket-qua-ca-nhan-test.pdf
--ResultPdfBoundary--

###

POST {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/submit-results
Authorization: Bearer {{accessToken}}

###

# Smoke anonymous/local: kích hoạt OAuth credential Google nếu cần và đọc metadata nhẹ của spreadsheet cấu hình.
# Không cần Authorization; response không chứa token/secret.
GET {{host}}/api/v1/google-sheets/credential-smoke

###

POST {{host}}/api/v1/google-sheets/sync-assessments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

###

POST {{host}}/api/v1/auth/logout
X-CSRF-TOKEN: {{csrfToken}}
