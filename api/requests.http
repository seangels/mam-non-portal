@host = https://localhost:7158
@accessToken = paste-access-token
@csrfToken = paste-csrf-token
@userId = 00000000-0000-0000-0000-000000000000
@studentId = 00000000-0000-0000-0000-000000000000
@teacherId = 00000000-0000-0000-0000-000000000000
@teacherUserId = 00000000-0000-0000-0000-000000000000
@teacherVersion = 1
@studentVersion = 1
@groupId = 00000000-0000-0000-0000-000000000000
@sheetId = 00000000-0000-0000-0000-000000000000
@attendanceDate = 2026-08-11
@assessmentSheetId = 00000000-0000-0000-0000-000000000000
@assessmentId = 00000000-0000-0000-0000-000000000000

GET {{host}}/api/v1/setup/status

### Chỉ thành công khi database chưa có bất kỳ user nào

POST {{host}}/api/v1/setup/super-admin
Content-Type: application/json

{
  "email": "superadmin@example.com",
  "fullName": "Super Admin",
  "password": "replace-with-strong-password"
}

###

POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "replace-with-password"
}

###

GET {{host}}/api/v1/auth/csrf

###

POST {{host}}/api/v1/auth/refresh
X-CSRF-TOKEN: {{csrfToken}}

###

GET {{host}}/api/v1/users?page=1&pageSize=20&role=Admin&sortBy=createdAt&sortOrder=desc
Authorization: Bearer {{accessToken}}

###

PUT {{host}}/api/v1/users/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "email": "admin@example.com",
  "fullName": "Admin",
  "phoneNumber": null,
  "role": "Admin",
  "status": "Active"
}

###

GET {{host}}/api/v1/students?page=1&pageSize=20&status=Active&studyMode=FullDay&studyWeekday=Monday&sortBy=studyMode&sortOrder=asc
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/students
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "studentCode": "HS-001",
  "fullName": "Nguyễn Văn An",
  "nickName": "Bé An",
  "dateOfBirth": "2021-01-02",
  "gender": "Male",
  "status": "Active",
  "guardianName": null,
  "guardianPhone": null,
  "note": null,
  "driveFolderId": null,
  "studySchedule": {
    "mode": "FullDay",
    "weekdays": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
  }
}

###

PUT {{host}}/api/v1/students/{{studentId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "studentCode": "HS-001",
  "fullName": "Nguyễn Văn An",
  "nickName": "Bé An",
  "dateOfBirth": "2021-01-02",
  "gender": "Male",
  "status": "Active",
  "guardianName": null,
  "guardianPhone": null,
  "note": null,
  "driveFolderId": null,
  "studySchedule": {
    "mode": "OneToOne",
    "weekdays": ["Monday", "Wednesday", "Friday"]
  },
  "expectedVersion": {{studentVersion}}
}

###

GET {{host}}/api/v1/teachers?page=1&pageSize=20&search=nguyen&unassigned=true&sortBy=fullName&sortOrder=asc
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/teachers
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "teacherCode": "GV-001",
  "fullName": "Nguyễn Thị Hoàng",
  "email": "teacher@example.com",
  "phoneNumber": "0901234567",
  "status": "Active",
  "password": "replace-with-strong-password",
  "note": null
}

###

GET {{host}}/api/v1/teachers/{{teacherId}}
Authorization: Bearer {{accessToken}}

###

PUT {{host}}/api/v1/teachers/{{teacherId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "teacherCode": "GV-001",
  "fullName": "Nguyễn Thị Hoàng",
  "email": "teacher@example.com",
  "phoneNumber": null,
  "status": "Active",
  "note": null,
  "expectedVersion": {{teacherVersion}}
}

###

PUT {{host}}/api/v1/teachers/{{teacherId}}/attendance-policy
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "attendanceEditWindowDays": 7,
  "expectedVersion": {{teacherVersion}}
}

###

PUT {{host}}/api/v1/users/{{teacherUserId}}/password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "password": "replace-with-new-strong-password"
}

###

DELETE {{host}}/api/v1/teachers/{{teacherId}}?expectedVersion={{teacherVersion}}
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/student-groups
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "code": "N1",
  "name": "Nhóm 1",
  "status": "Active"
}

###

PUT {{host}}/api/v1/student-groups/{{groupId}}/responsible-teacher
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "teacherId": "{{teacherId}}"
}

###

PUT {{host}}/api/v1/students/{{studentId}}/group
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "groupId": "{{groupId}}",
  "expectedVersion": {{studentVersion}}
}

###

DELETE {{host}}/api/v1/students/{{studentId}}?expectedVersion={{studentVersion}}
Authorization: Bearer {{accessToken}}

###

GET {{host}}/api/v1/attendance/context?date={{attendanceDate}}
Authorization: Bearer {{accessToken}}

###

GET {{host}}/api/v1/attendance/daily?date={{attendanceDate}}&groupId={{groupId}}
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/attendance/sheets
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "groupId": "{{groupId}}",
  "date": "{{attendanceDate}}",
  "expectedSnapshotVersion": 1,
  "records": [
    {
      "studentId": "{{studentId}}",
      "status": "Unmarked",
      "halfDayPart": null,
      "isExcused": null,
      "durationMinutes": null,
      "notes": null
    }
  ]
}

###

PUT {{host}}/api/v1/attendance/sheets/{{sheetId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "expectedVersion": 1,
  "records": [
    {
      "studentId": "{{studentId}}",
      "status": "AbsentHalfDay",
      "halfDayPart": null,
      "isExcused": true,
      "durationMinutes": null,
      "notes": "Gia đình đã báo"
    }
  ]
}

###

GET {{host}}/api/v1/assessment-sheets?page=1&pageSize=20&studentId={{studentId}}&status=Open&sortBy=updatedAt&sortOrder=desc
Authorization: Bearer {{accessToken}}

###

GET {{host}}/api/v1/assessment-sheets/plan-candidates?studentId={{studentId}}&latestGradeAtOrBelow=B&groupLv1Name=&sortBy=rowIndex&sortOrder=asc
Authorization: Bearer {{accessToken}}

###

GET {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/assessment-sheets
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "8.9.10.26",
  "studentId": "{{studentId}}",
  "responsibleTeacherId": null,
  "note": null,
  "startDate": "2026-08-20T00:00:00+07:00",
  "dueDate": "2026-10-31T00:00:00+07:00",
  "assessmentIds": ["{{assessmentId}}"]
}

###

PUT {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "8.9.10.26",
  "responsibleTeacherId": "{{teacherId}}",
  "note": null,
  "startDate": "2026-08-20T00:00:00+07:00",
  "dueDate": "2026-10-31T00:00:00+07:00",
  "feedback": null
}

###

PUT {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/records
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "records": [
    {
      "assessmentId": "{{assessmentId}}",
      "planGrade": "B",
      "planNote": null,
      "finalGrade": null,
      "finalNote": null
    }
  ]
}

###

PUT {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "Done"
}

###
# Các action Google Sheet/PDF dưới đây gọi Drive/Sheets thật (copy file mẫu [F01], ghi sheet, export PDF, ghi [F0.ĐG]).
# Định dạng cột trong sheet data/khcn_template/KQ_template hiện là suy đoán tạm, chưa có mapping thật từ đội vận hành
# (xem docs/requirements/09-bang-danh-gia-nang-luc.md mục 15) — chỉ chạy khi đã xác nhận service account có quyền
# đọc/copy file mẫu gen_assessment_sheet trên Drive, tránh tạo file rác/ghi nhầm trên Google Sheet thật.

POST {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/export-to-sheet
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/sync-to-sheet
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/generate-plan-pdf
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/generate-result-pdf
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/assessment-sheets/{{assessmentSheetId}}/submit-results
Authorization: Bearer {{accessToken}}

###

POST {{host}}/api/v1/google-sheets/sync-assessments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

###

POST {{host}}/api/v1/auth/logout
X-CSRF-TOKEN: {{csrfToken}}
