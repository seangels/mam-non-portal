{
  "name": "devextreme-angular-template",
  "version": "0.0.0",
  "scripts": {
    "preinstall": "node ./scripts/check-toolchain.cjs",
    "ng": "ng",
    "prestart": "npm run setup:https",
    "start": "ng serve",
    "setup:https": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-https.ps1",
    "build": "ng build",
    "copy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/copy-build-to-api.ps1",
    "copy:build:api": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/copy-build-to-api.ps1",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --progress=false",
    "build-themes": "devextreme build",
    "postinstall": "npm run build-themes"
  },
  "private": true,
  "engines": {
    "node": "14.21.3",
    "npm": "8.19.4"
  },
  "packageManager": "npm@8.19.4",
  "dependencies": {
    "@angular/animations": "12.2.17",
    "@angular/cdk": "12.2.13",
    "@angular/common": "12.2.17",
    "@angular/compiler": "12.2.17",
    "@angular/core": "12.2.17",
    "@angular/forms": "12.2.17",
    "@angular/platform-browser": "12.2.17",
    "@angular/platform-browser-dynamic": "12.2.17",
    "@angular/router": "12.2.17",
    "devextreme": "19.2.5",
    "devextreme-angular": "19.2.5",
    "devextreme-schematics": "1.6.0",
    "html2pdf.js": "0.10.1",
    "rxjs": "7.4.0",
    "tslib": "2.3.1",
    "zone.js": "0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "12.2.17",
    "@angular/cli": "12.2.17",
    "@angular/compiler-cli": "12.2.17",
    "@types/jasmine": "3.8.2",
    "devextreme-cli": "1.6.4",
    "devextreme-themebuilder": "19.2.5",
    "jasmine-core": "3.8.0",
    "karma": "6.3.20",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "2.0.3",
    "karma-jasmine": "4.0.2",
    "karma-jasmine-html-reporter": "1.7.0",
    "typescript": "4.3.5"
  },
  "overrides": {
    "browserslist": "4.28.8",
    "devextreme-angular@19.2.5": {
      "devextreme-schematics": "1.6.0"
    },
    "node-releases": "2.0.44",
    "sass": "1.69.7"
  }
}
